{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ephemeral Privacy",
  "version": "0.1.0",
  "identifier": "com.ephemeral.privacy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Ephemeral Privacy Suite",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
